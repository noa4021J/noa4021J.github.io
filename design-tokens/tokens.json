{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "noa4021j portfolio design system — W3C DTCG format. Source of truth. Generate CSS vars / Tailwind theme / Figma (Tokens Studio) from this file.",

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["IBM Plex Sans JP", "Hiragino Sans", "sans-serif"], "$description": "本文・見出し。読みやすさ優先の和文サンセリフ。" },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "ブランド名・ナビ・ラベル・メタ情報・コード。世界観の核。" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "38px", "$description": "Home hero の名前" },
      "h1": { "$type": "dimension", "$value": "32px", "$description": "ページタイトル" },
      "h2": { "$type": "dimension", "$value": "22px", "$description": "記事内見出し / カードタイトル(大)" },
      "h3": { "$type": "dimension", "$value": "17px", "$description": "カード・行タイトル" },
      "body": { "$type": "dimension", "$value": "16px", "$description": "記事本文" },
      "ui": { "$type": "dimension", "$value": "14px", "$description": "UI本文・説明文" },
      "meta": { "$type": "dimension", "$value": "12px", "$description": "日付・eyebrow・ナビ（mono）" },
      "micro": { "$type": "dimension", "$value": "11px", "$description": "チップ・キャプション（mono）" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.45, "$description": "見出し" },
      "ui": { "$type": "number", "$value": 1.7, "$description": "UIテキスト" },
      "prose": { "$type": "number", "$value": 1.95, "$description": "記事本文" }
    },
    "letterSpacing": {
      "heading": { "$type": "dimension", "$value": "-0.01em" },
      "display": { "$type": "dimension", "$value": "-0.02em" },
      "eyebrow": { "$type": "dimension", "$value": "0.08em", "$description": "uppercase eyebrow用" }
    }
  },

  "color": {
    "light": {
      "bg": { "$type": "color", "$value": "#fafaf7" },
      "card": { "$type": "color", "$value": "#ffffff" },
      "chip": { "$type": "color", "$value": "rgba(255,255,255,0.6)" },
      "ink": { "$type": "color", "$value": "#17181c", "$description": "見出し・最重要テキスト" },
      "body": { "$type": "color", "$value": "#2b2c31", "$description": "記事本文" },
      "sub": { "$type": "color", "$value": "#55565c", "$description": "リード文・説明" },
      "muted": { "$type": "color", "$value": "#6b6b6b", "$description": "二次テキスト" },
      "faint": { "$type": "color", "$value": "#8a8a8a", "$description": "メタ情報" },
      "ghost": { "$type": "color", "$value": "#a3a29e", "$description": "日付・プレースホルダー" },
      "dim": { "$type": "color", "$value": "#c9c8c3", "$description": "最弱テキスト・無効" },
      "line": { "$type": "color", "$value": "rgba(23,24,28,0.12)", "$description": "標準ボーダー" },
      "lineSoft": { "$type": "color", "$value": "rgba(23,24,28,0.08)", "$description": "行区切り" },
      "accent": { "$type": "color", "$value": "#4a6a75", "$description": "スレートブルーグレー。リンク・強調・ホバー" },
      "accentWash": { "$type": "color", "$value": "rgba(74,106,117,0.045)", "$description": "ホバー背景・コールアウト背景" },
      "stripeA": { "$type": "color", "$value": "#e3e2dc", "$description": "画像プレースホルダー縞" },
      "stripeB": { "$type": "color", "$value": "#eceae3" },
      "glow": { "$type": "color", "$value": "rgba(74,106,117,0.14)", "$description": "ヒーロー背景グロー" },
      "glowA": { "$type": "color", "$value": "rgba(74,106,117,0.13)", "$description": "デュオトーングロー（アクセント側）" },
      "glowB": { "$type": "color", "$value": "rgba(196,158,122,0.07)", "$description": "デュオトーングロー（暖色側）" },
      "grid": { "$type": "color", "$value": "rgba(23,24,28,0.04)", "$description": "背景グリッド線" },
      "shadow": { "$type": "color", "$value": "rgba(23,24,28,0.09)" },
      "shadowSoft": { "$type": "color", "$value": "rgba(23,24,28,0.06)" },
      "navBg": { "$type": "color", "$value": "rgba(250,250,247,0.85)", "$description": "フローティングナビ（blur下地）" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#101114" },
      "card": { "$type": "color", "$value": "#1b1c22" },
      "chip": { "$type": "color", "$value": "rgba(27,28,34,0.7)" },
      "ink": { "$type": "color", "$value": "#eceae4" },
      "body": { "$type": "color", "$value": "#c6c5bf" },
      "sub": { "$type": "color", "$value": "#a7a8ad" },
      "muted": { "$type": "color", "$value": "#94959b" },
      "faint": { "$type": "color", "$value": "#7d7e84" },
      "ghost": { "$type": "color", "$value": "#5b5c62" },
      "dim": { "$type": "color", "$value": "#45464c" },
      "line": { "$type": "color", "$value": "rgba(236,234,228,0.16)" },
      "lineSoft": { "$type": "color", "$value": "rgba(236,234,228,0.09)" },
      "accent": { "$type": "color", "$value": "#93b0ba" },
      "accentWash": { "$type": "color", "$value": "rgba(147,176,186,0.06)" },
      "stripeA": { "$type": "color", "$value": "#22232a" },
      "stripeB": { "$type": "color", "$value": "#1d1e24" },
      "glow": { "$type": "color", "$value": "rgba(147,176,186,0.09)" },
      "glowA": { "$type": "color", "$value": "rgba(147,176,186,0.2)" },
      "glowB": { "$type": "color", "$value": "rgba(196,158,122,0.1)" },
      "grid": { "$type": "color", "$value": "rgba(236,234,228,0.045)" },
      "shadow": { "$type": "color", "$value": "rgba(0,0,0,0.45)" },
      "shadowSoft": { "$type": "color", "$value": "rgba(0,0,0,0.3)" },
      "navBg": { "$type": "color", "$value": "rgba(20,21,25,0.82)" }
    },
    "code": {
      "$description": "コードブロックはライト/ダーク共通（常にダーク面）",
      "bg": { "$type": "color", "$value": "#14151a" },
      "header": { "$type": "color", "$value": "#1c1d24" },
      "text": { "$type": "color", "$value": "#e6e6e6" },
      "comment": { "$type": "color", "$value": "#7d8296" },
      "keyword": { "$type": "color", "$value": "#c792ea" },
      "function": { "$type": "color", "$value": "#82aaff" },
      "type": { "$type": "color", "$value": "#ffcb6b" },
      "string": { "$type": "color", "$value": "#c3e88d" },
      "meta": { "$type": "color", "$value": "#8b8fa3" },
      "dim": { "$type": "color", "$value": "#5f6377" },
      "dotRed": { "$type": "color", "$value": "#e0645c" },
      "dotYellow": { "$type": "color", "$value": "#e5b95c" },
      "dotGreen": { "$type": "color", "$value": "#5cb96b" }
    }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px", "$description": "ページ左右padding" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px", "$description": "セクション間(標準)" },
    "22": { "$type": "dimension", "$value": "88px", "$description": "セクション間(大・Home)" }
  },

  "layout": {
    "contentMaxWidth": { "$type": "dimension", "$value": "768px", "$description": "全ページ共通のコンテンツ幅" },
    "proseMaxWidth": { "$type": "dimension", "$value": "560px", "$description": "リード文などの読みやすい行長" }
  },

  "radius": {
    "sm": { "$type": "dimension", "$value": "4px", "$description": "タグチップ" },
    "md": { "$type": "dimension", "$value": "10px", "$description": "コードブロック・コールアウト" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "カード(小)" },
    "xl": { "$type": "dimension", "$value": "16px", "$description": "ショーケースカバー" },
    "pill": { "$type": "dimension", "$value": "9999px", "$description": "ナビ・バッジ・アイコンボタン" }
  },

  "elevation": {
    "raised": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "22px", "spread": "0px", "color": "{color.light.shadowSoft}" }, "$description": "カード標準" },
    "float": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px", "color": "{color.light.shadowSoft}" }, "$description": "ショーケースカバー" },
    "hover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "44px", "spread": "0px", "color": "{color.light.shadow}" }, "$description": "ホバー時" }
  },

  "motion": {
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.3, 1], "$description": "標準イージング（reveal, hover-lift, zoom）" }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$description": "色・ボーダーのホバー" },
      "base": { "$type": "duration", "$value": "250ms", "$description": "行のスライド" },
      "slow": { "$type": "duration", "$value": "600ms", "$description": "画像ズーム" },
      "reveal": { "$type": "duration", "$value": "800ms", "$description": "fadeUp / スクロールリビール" }
    },
    "revealDistance": { "$type": "dimension", "$value": "20px", "$description": "fadeUp の translateY 初期値" },
    "staggerStep": { "$type": "duration", "$value": "80ms", "$description": "ヒーロー要素の順次表示間隔" }
  },

  "effect": {
    "grid": { "size": { "$type": "dimension", "$value": "56px" }, "$description": "背景グリッド。上から72%地点までマスクフェード" },
    "grainOpacity": {
      "light": { "$type": "number", "$value": 0.05 },
      "dark": { "$type": "number", "$value": 0.07 },
      "$description": "SVG feTurbulence (baseFrequency 0.82, 2 octaves, saturate 0) の紙質グレイン"
    },
    "navBlur": { "$type": "dimension", "$value": "12px", "$description": "フローティングナビ backdrop-filter" }
  }
}
