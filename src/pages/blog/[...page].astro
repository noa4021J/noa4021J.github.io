---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// 1ページ目のみ、最新3件をアイキャッチ付きでフィーチャー（1件大 + 2件グリッド）。
// 残りは通常のリスト。2ページ目以降はフィーチャーなしの通常リストのみ。
const isFirstPage = page.currentPage === 1;
const featuredMain = isFirstPage ? page.data[0] : null;
const featuredSub = isFirstPage ? page.data.slice(1, 3) : [];
const listPosts = isFirstPage ? page.data.slice(3) : page.data;

function dateLabel(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, ".");
}
---

<BaseLayout title="Blog" description="noa4021j のテックブログ記事一覧です。">
  <div class="fade-in flex items-baseline justify-between">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-wide text-muted">// blog</p>
      <h1 class="mt-2.5 text-h1 font-bold tracking-tight text-ink">Blog</h1>
    </div>
    <a href="/tags" class="font-mono text-xs text-muted hover:text-ink">./tags →</a>
  </div>

  {
    featuredMain && (
      <div class="reveal mt-9">
        <a href={`/blog/${featuredMain.id}`} class="showcase block">
          <div class="sc-cover relative h-[300px] overflow-hidden rounded-xl border border-line shadow-float">
            {featuredMain.data.coverImage ? (
              <img src={featuredMain.data.coverImage} alt={featuredMain.data.title} class="sc-img absolute inset-0 h-full w-full object-cover" />
            ) : (
              <div class="sc-img bg-stripes absolute inset-0 flex items-center justify-center font-mono text-xs text-ghost">eyecatch</div>
            )}
            <span class="absolute bottom-3 left-4 rounded-pill border border-line-soft bg-nav px-3 py-1.5 font-mono text-[11px] text-sub backdrop-blur-md">
              {featuredMain.data.category}
            </span>
          </div>
          <div class="mt-4">
            <p class="font-mono text-[11px] text-faint">{dateLabel(featuredMain.data.pubDate)}</p>
            <span class="sc-title mt-1.5 block text-xl font-bold text-ink">{featuredMain.data.title}</span>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{featuredMain.data.description}</p>
          </div>
        </a>

        {featuredSub.length > 0 && (
          <div class="mt-9 grid grid-cols-2 gap-6">
            {featuredSub.map((post) => (
              <a href={`/blog/${post.id}`} class="showcase block">
                <div class="sc-cover relative h-[170px] overflow-hidden rounded-lg border border-line shadow-raised">
                  {post.data.coverImage ? (
                    <img src={post.data.coverImage} alt={post.data.title} class="sc-img absolute inset-0 h-full w-full object-cover" />
                  ) : (
                    <div class="sc-img bg-stripes absolute inset-0 flex items-center justify-center font-mono text-[11px] text-ghost">eyecatch</div>
                  )}
                </div>
                <div class="mt-3">
                  <p class="font-mono text-[11px] text-faint">
                    {dateLabel(post.data.pubDate)} · {post.data.category}
                  </p>
                  <span class="sc-title mt-1 block text-[15.5px] font-semibold leading-snug text-ink">{post.data.title}</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }

  <p class="reveal mt-14 font-mono text-xs font-semibold uppercase tracking-wide text-muted">// all posts</p>
  <div class="reveal mt-2">
    {listPosts.map((post) => <PostCard post={post} showTags />)}
  </div>

  <nav class="mt-8 flex justify-between font-mono text-sm">
    {page.url.prev ? <a href={page.url.prev} class="text-accent hover:underline">← prev</a> : <span class="text-dim">← prev</span>}
    {page.url.next ? <a href={page.url.next} class="text-accent hover:underline">next →</a> : <span />}
  </nav>
</BaseLayout>
