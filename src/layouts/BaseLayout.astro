---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImagePath?: string;
}

const { title, description, ogImagePath } = Astro.props;

const siteName = "noa4021j";
const pageTitle = `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImagePath ?? "/og/default.png", Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* テーマ初期化: 描画前にlocalStorageから復元し、フラッシュを防ぐ */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("noa-portfolio-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans flex min-h-screen flex-col antialiased relative">
    {/* 背景効果: グリッド + グロー + グレイン。コンテンツの後ろに固定表示 */}
    <div class="pointer-events-none fixed inset-x-0 top-0 z-0 h-[900px] overflow-hidden">
      <div class="noa-bg-grid absolute inset-0"></div>
      <div class="noa-bg-glow-a absolute left-[16%] top-[-260px] h-[560px] w-[920px]"></div>
      <div class="noa-bg-glow-b absolute right-[2%] top-[-120px] h-[480px] w-[640px]"></div>
    </div>
    <div class="noa-bg-grain pointer-events-none fixed inset-0 z-40"></div>

    <div class="relative z-10 flex min-h-screen flex-1 flex-col">
      <Header />
      <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
        <slot />
      </main>
      <Footer />
    </div>

    {/* .reveal 要素をスクロールで順次フェードインさせる共通オブザーバー */}
    <script is:inline>
      (function () {
        function init() {
          var els = document.querySelectorAll(".reveal:not(.on)");
          if (!els.length) return;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("on");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
