---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  category: string;
  slug: string;
}

const { title, description, pubDate, updatedDate, tags, category, slug } = Astro.props;
---

<BaseLayout title={title} description={description} ogImagePath={`/og/${slug}.png`}>
  <article class="pt-2">
    <header class="mb-9 border-b border-line pb-8">
      <p class="font-mono text-xs text-ghost">~/blog/{slug}</p>
      <p class="mt-3 font-mono text-xs text-faint">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, ".")}
        </time>
        {
          updatedDate && (
            <span>
              {" "}
              (更新:{" "}
              <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, ".")}
              </time>
              )
            </span>
          )
        }
        <span class="mx-2">·</span>
        {category}
      </p>
      <h1 class="mt-3 text-h1 font-bold leading-snug tracking-tight text-ink">{title}</h1>
      <div class="mt-4">
        <TagList tags={tags} />
      </div>
    </header>
    <div class="prose prose-neutral max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
