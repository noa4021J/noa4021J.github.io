---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${tag}`}
            class="tag-chip rounded-sm border border-line px-2.5 py-1 font-mono text-xs text-muted"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
