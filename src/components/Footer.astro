---
import { getCollection } from "astro:content";

const year = new Date().getFullYear();
const footerSocialIds = ["x", "github", "rss"];
const links = (await getCollection("socials", ({ id }) => footerSocialIds.includes(id))).sort(
  (a, b) => a.data.order - b.data.order
);
---

<footer class="border-t border-line">
  <div class="mx-auto w-full max-w-3xl px-6 py-7">
    <p class="mb-3 font-mono text-[11px] text-dim">// build 2026.07</p>
    <div class="flex flex-col gap-3 font-mono text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} noa4021j</p>
      <nav class="flex gap-4">
        {
          links.map((link) => (
            <a href={link.data.url} class="hover:text-ink">
              {link.id}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
